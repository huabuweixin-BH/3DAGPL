<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.threedagpl.system.mapper.AiChatHistoryMapper">
    
    <resultMap type="AiChatHistory" id="AiChatHistoryResult">
        <result property="id"         column="id"         />
        <result property="userId"     column="user_id"    />
        <result property="question"   column="question"   />
        <result property="answer"     column="answer"     />
        <result property="createTime" column="create_time"/>
    </resultMap>

    <sql id="selectAiChatHistoryVo">
        select id, user_id, question, answer, create_time 
        from ai_chat_history
    </sql>

    <select id="selectAiChatHistoryList" parameterType="AiChatHistory" resultMap="AiChatHistoryResult">
        <include refid="selectAiChatHistoryVo"/>
        <where>  
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="question != null  and question != ''"> and question like concat('%', #{question}, '%')</if>
            <if test="answer != null  and answer != ''"> and answer like concat('%', #{answer}, '%')</if>
        </where>
        order by create_time desc
    </select>

    <select id="selectAiChatHistoryById" parameterType="Long" resultMap="AiChatHistoryResult">
        <include refid="selectAiChatHistoryVo"/>
        where id = #{id}
    </select>

    <select id="selectAiChatHistoryByUserId" parameterType="Long" resultMap="AiChatHistoryResult">
        <include refid="selectAiChatHistoryVo"/>
        where user_id = #{userId}
        order by create_time desc
    </select>
        
    <insert id="insertAiChatHistory" parameterType="AiChatHistory" useGeneratedKeys="true" keyProperty="id">
        insert into ai_chat_history
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="question != null and question != ''">question,</if>
            <if test="answer != null and answer != ''">answer,</if>
            create_time
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="question != null and question != ''">#{question},</if>
            <if test="answer != null and answer != ''">#{answer},</if>
            CURRENT_TIMESTAMP
         </trim>
    </insert>

    <delete id="deleteAiChatHistoryById" parameterType="Long">
        delete from ai_chat_history where id = #{id}
    </delete>

    <delete id="deleteAiChatHistoryByIds" parameterType="Long">
        delete from ai_chat_history where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
