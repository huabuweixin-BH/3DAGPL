<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.threedagpl.system.mapper.BlogArticleMapper">

    <resultMap type="BlogArticle" id="BlogArticleResult">
        <result property="id"    column="id"    />
        <result property="title"    column="title"    />
        <result property="summary"    column="summary"    />
        <result property="coverUrl"    column="cover_url"    />
        <result property="contentHtml"    column="content_html"    />
        <result property="contentText"    column="content_text"    />
        <result property="status"    column="status"    />
        <result property="isTop"    column="is_top"    />
        <result property="isVisible"    column="is_visible"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
        <result property="embedding"    column="embedding"    />
    </resultMap>

    <sql id="selectBlogArticleVo">
        select id, title, summary, cover_url, content_html, content_text, status, is_top, is_visible, create_by, create_time, update_by, update_time, remark, embedding from blog_article
    </sql>

    <select id="selectBlogArticleList" parameterType="BlogArticle" resultMap="BlogArticleResult">
        <include refid="selectBlogArticleVo"/>
        <where>
            <if test="title != null  and title != ''"> and title = #{title}</if>
            <if test="summary != null  and summary != ''"> and summary = #{summary}</if>
            <if test="coverUrl != null  and coverUrl != ''"> and cover_url = #{coverUrl}</if>
            <if test="contentHtml != null  and contentHtml != ''"> and content_html = #{contentHtml}</if>
            <if test="contentText != null  and contentText != ''"> and content_text = #{contentText}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="isTop != null  and isTop != ''"> and is_top = #{isTop}</if>
            <if test="isVisible != null  and isVisible != ''"> and is_visible = #{isVisible}</if>
            <if test="embedding != null  and embedding != ''"> and embedding = #{embedding}</if>
        </where>
    </select>

    <select id="selectBlogArticleById" parameterType="Long" resultMap="BlogArticleResult">
        <include refid="selectBlogArticleVo"/>
        where id = #{id}
    </select>

    <insert id="insertBlogArticle" parameterType="BlogArticle">
        insert into blog_article
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="title != null and title != ''">title,</if>
            <if test="summary != null and summary != ''">summary,</if>
            <if test="coverUrl != null">cover_url,</if>
            <if test="contentHtml != null and contentHtml != ''">content_html,</if>
            <if test="contentText != null">content_text,</if>
            <if test="status != null">status,</if>
            <if test="isTop != null">is_top,</if>
            <if test="isVisible != null">is_visible,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
            <if test="embedding != null">embedding,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="title != null and title != ''">#{title},</if>
            <if test="summary != null and summary != ''">#{summary},</if>
            <if test="coverUrl != null">#{coverUrl},</if>
            <if test="contentHtml != null and contentHtml != ''">#{contentHtml},</if>
            <if test="contentText != null">#{contentText},</if>
            <if test="status != null">#{status},</if>
            <if test="isTop != null">#{isTop},</if>
            <if test="isVisible != null">#{isVisible},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
            <if test="embedding != null">#{embedding},</if>
        </trim>
    </insert>

    <update id="updateBlogArticle" parameterType="BlogArticle">
        update blog_article
        <trim prefix="SET" suffixOverrides=",">
            <if test="title != null and title != ''">title = #{title},</if>
            <if test="summary != null and summary != ''">summary = #{summary},</if>
            <if test="coverUrl != null">cover_url = #{coverUrl},</if>
            <if test="contentHtml != null and contentHtml != ''">content_html = #{contentHtml},</if>
            <if test="contentText != null">content_text = #{contentText},</if>
            <if test="status != null">status = #{status},</if>
            <if test="isTop != null">is_top = #{isTop},</if>
            <if test="isVisible != null">is_visible = #{isVisible},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="embedding != null">embedding = #{embedding},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteBlogArticleById" parameterType="Long">
        delete from blog_article where id = #{id}
    </delete>

    <delete id="deleteBlogArticleByIds" parameterType="String">
        delete from blog_article where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>